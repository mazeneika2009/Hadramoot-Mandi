{
  "name": "@hadramout/server",
  "version": "1.0.0",
  "private": true,
  "description": "Hadramout House of Mandi REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format cjs --target node20 --out-dir dist --clean",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx src/db/init.ts",
    "db:seed": "tsx src/db/seedCli.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
